<?xml version="1.0" encoding="utf-8"?>
<!--
    Google Play: no in-app updater (Play updates the app), none of the permissions Play keeps for
    default SMS and dialer apps (so no SMS feature, and calls without the number), and no full
    screen intent (kept for calling and alarm apps): the ring notice is a heads-up notification.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Removed, not declared: the telephony uses-feature in main applies, lint misreads these. -->

    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_SMS"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.SEND_SMS"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RECEIVE_SMS"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_CALL_LOG"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.USE_FULL_SCREEN_INTENT"
        tools:node="remove" />

    <application>
        <receiver
            android:name=".update.InstallResultReceiver"
            tools:node="remove" />
    </application>

</manifest>
