<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- One of the prerequisites Android 14 requires for a connectedDevice service. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only to read the pairing QR code; pasting the code works without it. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Connectivity packet: whether the phone is on Wi-Fi, mobile data or nothing. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        Connectivity packet: Android requires it to read the mobile network type (5G, LTE…).
        Asked only from the settings; without it only Wi-Fi and "none" are sent.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Calls: the caller's number (Android 10+) and name. Asked only when Calls is switched on. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!--
        SMS for the computers: threads and messages, sending, and new messages while Weft runs.
        Asked only when SMS is switched on. Contacts (above) also gives the threads their names.
    -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Ring: the "Found it" notice over the lock screen (Android 14+ lets the user refuse it). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Received files go to the public Downloads folder; from Android 10 MediaStore needs none. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Updates: installing a newer Weft downloaded from GitHub Releases (Settings, Updates). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- App names for mirrored notifications, media players and the excluded apps list. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- No backups or device transfers: device keys will live in this app. -->
    <application
        android:name=".WeftApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Weft">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Invisible activity that reads the clipboard once it has window focus (required since
            Android 10), hands the text to the sender and finishes. Not exported: other apps reach
            it only through the share alias below, which never reads the clipboard.
        -->
        <activity
            android:name=".ClipboardSendActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity="fr.frohub.weft.send"
            android:theme="@style/Theme.Weft.Invisible" />

        <activity-alias
            android:name=".ShareTextActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:targetActivity=".ClipboardSendActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".ShareClipboardImageActivity"
            android:exported="true"
            android:label="@string/share_clipboard_image_label"
            android:targetActivity=".ClipboardSendActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/png" />
                <data android:mimeType="image/jpeg" />
            </intent-filter>
        </activity-alias>

        <!--
            Share target for files of any type. A share with text only is handed to the text
            share target above.
        -->
        <activity
            android:name=".ShareFileActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_file_label"
            android:taskAffinity="fr.frohub.weft.send"
            android:theme="@style/Theme.Weft.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!-- The "Find my phone" notice, shown over the lock screen. -->
        <activity
            android:name=".features.RingActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="fr.frohub.weft.ring" />

        <!-- Notification actions: "Found it", cancelling a transfer. -->
        <receiver
            android:name=".features.FeatureReceiver"
            android:exported="false" />

        <!-- The package installer's answer to an update install (update/Updater.kt). -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

        <!-- Opens files received below Android 10 (from Android 10 they are MediaStore items). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name=".ClipboardTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
            Notifications and media sessions for the computers. Bound by Android only once the
            user allows Weft to read notifications in the system settings.
        -->
        <service
            android:name=".features.WeftNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            The Weft keyboard: types what a computer sends. Bound by Android only once the user
            turns it on and picks it as the keyboard.
        -->
        <service
            android:name=".features.WeftKeyboard"
            android:exported="true"
            android:label="@string/keyboard_label"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!--
            Keeps the relay connection while the device is paired. Never started at boot:
            Android 15 forbids starting a connectedDevice service from BOOT_COMPLETED.
        -->
        <service
            android:name=".WeftService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
