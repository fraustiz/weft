<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!-- One of the prerequisites Android 14 requires for a connectedDevice service. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only to read the pairing QR code; pasting the code works without it. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- No backups or device transfers: device keys will live in this app. -->
    <application
        android:name=".WeftApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Weft">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Invisible activity that reads the clipboard once it has window focus (required since
            Android 10), hands the text to the sender and finishes. Not exported: other apps reach
            it only through the share alias below, which never reads the clipboard.
        -->
        <activity
            android:name=".ClipboardSendActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity="fr.frohub.weft.send"
            android:theme="@style/Theme.Weft.Invisible" />

        <activity-alias
            android:name=".ShareTextActivity"
            android:exported="true"
            android:label="@string/share_label"
            android:targetActivity=".ClipboardSendActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".ClipboardTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
            Keeps the relay connection while the device is paired. Never started at boot:
            Android 15 forbids starting a connectedDevice service from BOOT_COMPLETED.
        -->
        <service
            android:name=".WeftService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>

</manifest>
