    <string name="settings_title">Réglages</string>
    <string name="settings_body">Ce que ce téléphone partage avec vos autres appareils et accepte d’eux. Une fonction désactivée ici leur est aussi masquée.</string>
    <string name="feature_battery">Batterie</string>
    <string name="feature_battery_body">Afficher le niveau de batterie de ce téléphone sur vos ordinateurs</string>
    <string name="feature_connectivity">Réseau</string>
    <string name="feature_connectivity_body">Indiquer si ce téléphone est en Wi-Fi ou en données mobiles, et son signal</string>
    <string name="feature_connectivity_permission">Android ne donne le type de réseau mobile (5G, LTE…) qu’aux applis autorisées à accéder au téléphone. Sans cela, seul le Wi-Fi est indiqué.</string>
    <string name="action_allow">Autoriser</string>
    <string name="feature_ring">Faire sonner</string>
    <string name="feature_ring_body">Vos ordinateurs peuvent faire sonner ce téléphone, même en silencieux, et vous pouvez les faire sonner d’ici</string>
    <string name="feature_ping">Ping</string>
    <string name="feature_ping_body">Envoyer et recevoir une simple notification</string>
    <string name="feature_links">Liens</string>
    <string name="feature_links_body">Les liens partagés avec Weft s’ouvrent sur l’ordinateur ; les siens arrivent en notification</string>
    <string name="feature_files">Fichiers</string>
    <string name="feature_files_body">Envoyer des fichiers à vos ordinateurs et recevoir les leurs dans Téléchargements</string>
    <string name="feature_notifications">Notifications</string>
    <string name="feature_notifications_body">Afficher les notifications de ce téléphone sur vos ordinateurs, et y répondre ou les fermer de là</string>
    <string name="feature_notifications_permission">Android vous demande d’abord d’autoriser Weft à lire les notifications.</string>
    <string name="feature_calls">Appels</string>
    <string name="feature_calls_body">Afficher les appels entrants sur vos ordinateurs, et couper la sonnerie de là</string>
    <string name="feature_calls_permission">Weft a besoin de l’accès au téléphone pour voir les appels, et de l’accès au journal d’appels et aux contacts pour afficher le numéro et le nom.</string>
    <string name="feature_media">Médias</string>
    <string name="feature_media_body">Contrôler ce qui joue sur ce téléphone depuis vos ordinateurs, et ce qui joue sur eux depuis ici</string>
    <string name="feature_media_permission">Android ne montre les lecteurs de ce téléphone qu’aux applis qui peuvent lire les notifications. Les lecteurs de vos ordinateurs fonctionnent sans.</string>
    <string name="feature_volume">Volume</string>
    <string name="feature_volume_body">Régler le volume multimédia de ce téléphone depuis vos ordinateurs, et le leur depuis ici</string>
