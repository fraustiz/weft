<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only; the UI itself is themed in Compose (ui/Theme.kt). -->
    <style name="Theme.Weft" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- No window, no animation, no dim: the activity only needs focus to read the clipboard. -->
    <style name="Theme.Weft.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
