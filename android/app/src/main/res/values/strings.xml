    <string name="device_name">Name</string>
    <string name="device_no_name">No name</string>
    <string name="device_id">Device ID</string>
    <string name="device_added">Added</string>
    <string name="device_remove_hint">Removing it stops it sending to or receiving from this phone and the rest of the group.</string>
    <string name="action_remove">Remove from group</string>
    <!-- %1$s: the device name or short id. -->
    <string name="remove_title">Remove %1$s?</string>
