    <string name="devices_title">Devices</string>
    <string name="device_open">Show details</string>
    <string name="more_options">More options</string>
    <string name="action_leave">Unpair this phone</string>
    <string name="leave_title">Unpair this phone?</string>
    <plurals name="leave_body">
        <item quantity="one">This phone leaves the group and forgets %d paired device. You can pair again at any time.</item>
        <item quantity="other">This phone leaves the group and forgets %d paired devices. You can pair again at any time.</item>
    </plurals>
    <string name="leave_offline_body">The relay can’t be reached, so the other devices can’t be told. Unpair anyway? They keep this phone in their list until you remove it there.</string>
    <string name="leave_confirm">Unpair</string>
    <string name="leave_confirm_offline">Unpair anyway</string>
    <string name="action_cancel">Cancel</string>
    <string name="group_change_busy">A pairing is in progress. Try again when it is done.</string>

