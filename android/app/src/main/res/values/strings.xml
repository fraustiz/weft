    <!-- Pairing errors: a title, then what to do. -->
    <string name="join_invalid_code">Not a Weft pairing code</string>
    <string name="join_invalid_code_body">Check that the whole code was copied, starting with WEFT1:</string>
    <string name="join_own_code">This code comes from this phone</string>
    <string name="join_own_code_body">Scan the code shown on your computer.</string>
    <string name="join_insecure_relay">This relay is not encrypted</string>
    <string name="join_insecure_relay_body">The code points to a ws:// relay, which only debug builds accept. Use a wss:// relay.</string>
    <string name="join_unreachable">Can’t reach the relay</string>
    <string name="join_unreachable_body">Check this phone’s internet connection, then try again.</string>
    <string name="join_relay_timed_out">The relay is not answering</string>
    <string name="join_relay_timed_out_body">It may be down or slow. Try again in a moment.</string>
    <string name="join_wrong_relay_name">Wrong relay name</string>
    <string name="join_wrong_relay_name_body">The relay announced another name than the one in the code, so this phone did not trust it. Check the relay address weft pair uses.</string>
    <string name="join_rejected">The relay refused this phone</string>
    <string name="join_rejected_body">Try again. If it keeps happening, the relay may not accept new devices.</string>
    <string name="join_protocol">Unexpected answer from the relay</string>
    <string name="join_protocol_body">The relay may run another version of Weft.</string>
    <string name="join_lost">The connection dropped</string>
    <string name="join_lost_body">Check the connection, then try again.</string>
    <string name="join_timed_out">No answer from the computer</string>
    <string name="join_timed_out_body">Make sure weft pair is still running on the computer, then try again.</string>
    <string name="join_expired">This code has expired</string>
    <string name="join_expired_body">A code works once, for 5 minutes. Run weft pair again for a new one.</string>
    <string name="join_not_allowed">Pairing not allowed</string>
    <string name="join_not_allowed_body">The relay did not allow this pairing. Show a new code and try again.</string>
    <string name="join_rate_limited">Too many attempts</string>
    <string name="join_rate_limited_body">Wait a minute, then try again.</string>
    <string name="join_group_full">This group is full</string>
    <string name="join_group_full_body">A group holds 10 devices at most. Remove one from it first.</string>
    <string name="join_busy">A pairing is already running</string>
    <string name="join_busy_body">Wait for it to finish, then try again.</string>

