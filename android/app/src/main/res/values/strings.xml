    <!-- Main screen, not paired. -->
    <string name="empty_title">Share your clipboard with your computers</string>
    <string name="empty_body">Text you copy on this phone can be pasted on your computers, and the other way round. It is end-to-end encrypted: the relay in between never sees it.</string>
    <string name="empty_steps_title">To pair</string>
    <!-- %1$s: the command, set in monospace. -->
    <string name="empty_step_run">On your computer, run %1$s</string>
